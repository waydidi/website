STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me
BOOKING_FROM_EMAIL=Waydidi <bookings@example.com>
BOOKING_ALERT_EMAIL=operations@example.com
WAYDIDI_PUBLIC_URL=https://waydidi.com
# Staff accounts are provisioned in D1; login requires TOTP MFA.
WAYDIDI_ADMIN_SESSION_SECRET=replace_with_a_separate_32_byte_random_secret
WAYDIDI_TRIP_PIN_SECRET=replace_with_a_separate_32_byte_random_secret
RATE_LIMIT_SALT=replace_with_a_long_random_secret
# Cloudflare Turnstile (invisible bot check on sign-up forms). Leave empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_BROWSER_KEY=replace_with_a_referrer_restricted_google_maps_key
GOOGLE_MAPS_SERVER_KEY=replace_with_a_routes_and_places_restricted_server_key
AVIATIONSTACK_API_KEY=replace_with_your_aviationstack_key
WAYDIDI_ROUTE_CORRIDOR_URBAN_METRES=1500
WAYDIDI_ROUTE_CORRIDOR_LONG_METRES=4000
WAYDIDI_ROUTE_LONG_DISTANCE_METRES=150000
WAYDIDI_ROUTE_DEVIATION_POINTS=4
WAYDIDI_ROUTE_DEVIATION_MINUTES=2
WAYDIDI_STOP_RADIUS_METRES=100
WAYDIDI_STOP_MIN_POINTS=8
WAYDIDI_STOP_TRANSFER_MINUTES=20
WAYDIDI_STOP_HOURLY_MINUTES=30
WAYDIDI_STOP_ROUTE_DEVIATION_MINUTES=15
WAYDIDI_STOP_MIN_REMAINING_METRES=2000
WAYDIDI_STOP_RESUME_METRES=200
WAYDIDI_STOP_RESUME_POINTS=3
# Social sign-in for customer accounts. Each button appears only when its values are set.
# Callback URL to register with each provider: https://<your-domain>/api/account/oauth/<provider>/callback
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=replace_with_line_login_channel_secret
APPLE_SIGNIN_CLIENT_ID=replace_with_apple_services_id
APPLE_SIGNIN_TEAM_ID=replace_with_apple_team_id
APPLE_SIGNIN_KEY_ID=replace_with_apple_sign_in_key_id
APPLE_SIGNIN_PRIVATE_KEY=replace_with_apple_p8_key_contents_with_\n_for_newlines
# Help page contact options. "Chat with us" (WhatsApp) and "Call us" appear only when set.
WAYDIDI_WHATSAPP_NUMBER=66812345678
WAYDIDI_SUPPORT_PHONE=+66 2 123 4567

# Telegram bridge for website chat (server-only secrets; never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# LINE LIFF (My Trips inside LINE). Create a LIFF app on the same LINE Login channel
# (Endpoint URL: https://waydidi.com/liff, scope: openid profile email) and paste its LIFF ID.
LINE_LIFF_ID=

# Bank transfer / PromptPay slips for pay-later (cash) bookings. Slips are offered only when
# WAYDIDI_SLIP_PAYEE_NAMES is set. Names and accounts are comma-separated.
WAYDIDI_SLIP_PAYEE_NAMES=
WAYDIDI_SLIP_PAYEE_ACCOUNTS=
# Shown to the customer, e.g. "PromptPay 0-1055-xxxxx-xx-x (Waydidi Travel Co., Ltd.)"
WAYDIDI_SLIP_PAYEE_DISPLAY=
# 1 lets clean slips (exact amount, right payee, readable, no duplicates) be approved without a person. Default off.
WAYDIDI_SLIP_AUTO_APPROVE=

# Telegram team assistant (answers staff questions in the staff group from Waydidi's data).
# On when ANTHROPIC_API_KEY is set; 0 turns it off. Monthly spending cap in US$ (default 20).
TELEGRAM_ASSISTANT=
TELEGRAM_ASSISTANT_MONTHLY_USD=

# Telegram driver group: new bookings are offered there in Thai with an Assign (รับงาน) link; drivers sign up
# and take jobs in their private chat with the bot. Off until TELEGRAM_DRIVER_JOBS=1 and the group's ID is set
# (must differ from TELEGRAM_CHAT_ID; send /chatid in the new group to see it).
TELEGRAM_DRIVER_JOBS=
TELEGRAM_DRIVER_CHAT_ID=
# Optional second driver group for jobs picked up in the south of Thailand (Phuket, Krabi, Phang Nga, Surat Thani/Samui,
# Hat Yai ...). Those jobs are offered only there; without it every job goes to TELEGRAM_DRIVER_CHAT_ID.
TELEGRAM_DRIVER_CHAT_ID_SOUTH=
# The Comment group (Facebook comment drafts with /c). Add the bot to a new group, send /chatid there, paste the ID here.
# Empty: /c works in the Admin group instead.
TELEGRAM_COMMENT_CHAT_ID=
# /trip and /place in the Admin group (team list only): staff type a trip with its price and the bot builds and sends a
# smart trip, then posts the itinerary link and PDF in the Admin group (never to the customer); /place adds or updates
# an attraction with opening hours and photos. Needs ANTHROPIC_API_KEY for /trip. Off until set to 1.
TELEGRAM_TRIP_BUILDER=

# New Telegram workflows are opt-in. Existing driver-job DMs keep working without these.
# Send private linked-driver notices for Admin assignments and cancellations/changes.
TELEGRAM_DRIVER_UPDATES=0
# 0 = do not look up the address / nearest place for a driver's step photo in the Admin group (the coordinates and Google Maps link are still shown).
TELEGRAM_PHOTO_PLACE_NAME=1
# 1 = after the Drop, prepaid jobs ask the driver for bank details (กรอกข้อมูลบัญชี). Off: the job just completes.
DRIVER_BANK_DETAILS=0
# Offer return journeys independently, after staff explicitly set their return driver cost.
TELEGRAM_RETURN_DRIVER_JOBS=0
