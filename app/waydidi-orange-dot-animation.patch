+.waydidi-intro {
+  position: fixed;
+  inset: 0;
+  z-index: 100;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  pointer-events: none;
+  background: #fff;
+  animation: waydidi-intro-hide 500ms linear forwards;
+}
+
+.waydidi-intro__dot {
+  position: absolute;
+  inset: 0;
+  background: #ff8a05;
+  will-change: clip-path;
+  animation: waydidi-dot-expand 500ms cubic-bezier(0.76, 0, 0.24, 1) forwards;
+}
+
+@keyframes waydidi-dot-expand {
+  from { clip-path: circle(12px at 50% 50%); }
+  to { clip-path: circle(75vmax at 50% 50%); }
+}
+
+@keyframes waydidi-intro-hide {
+  0%, 92% { visibility: visible; }
+  100% { visibility: hidden; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .waydidi-intro { display: none; }
+}
